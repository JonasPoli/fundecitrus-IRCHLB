{% extends 'pub/base.html.twig' %}

{% block body %}
    <section class="bg-slate-900 text-white py-20 relative overflow-hidden border-b-8 border-secondary">
        {% if event_config and event_config.heroImage and event_config.heroImage.imageName %}
            <div class="absolute inset-0 opacity-30 bg-cover bg-center" style="background-image: url('{{ ('uploads/' ~ event_config.heroImage.imageName)|imagine_filter('banner_hero') }}'); background-color: #004040;"></div>
        {% else %}
            <div class="absolute inset-0 opacity-30 bg-cover bg-center" style="background-image: url('{{ asset('images/hero-bg.jpg') }}'); background-color: #004040;"></div>
        {% endif %}
        <div class="container mx-auto px-6 text-center relative z-10">
            <span class="material-symbols-outlined text-secondary text-5xl mb-4">confirmation_number</span>
            <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Registration</h1>
            <p class="text-secondary text-lg max-w-2xl mx-auto">Secure your spot at the world's most significant citrus desease events. Review our distinct categories and deadlines below.</p>
        </div>
    </section>

    <!-- Pricing Tables -->
    <section class="py-24 bg-white text-slate-800">
        <div class="container mx-auto px-6">

            <!-- Registration Periods & Deadlines -->
            <div class="mb-16 max-w-5xl mx-auto" data-aos="fade-up">
                <h3 class="text-2xl font-bold text-primary mb-6 text-center">Registration Periods & Deadlines</h3>
                <div class="overflow-x-auto card-shadow rounded-xl">
                    <table class="w-full text-left border-collapse text-sm">
                        <thead>
                            <tr class="bg-slate-800 text-white uppercase tracking-wider text-xs">
                                <th class="py-3.5 px-6 font-bold">Period</th>
                                <th class="py-3.5 px-6 font-bold">Dates</th>
                                
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-slate-100">
                            <tr class="hover:bg-slate-50">
                                <td class="py-3.5 px-6 font-bold text-primary">Early Bird</td>
                                <td class="py-3.5 px-6 text-slate-700">1 December 2026 to 1 May 2027</td>
                                
                            </tr>
                            <tr class="hover:bg-slate-50">
                                <td class="py-3.5 px-6 font-bold text-primary">Regular</td>
                                <td class="py-3.5 px-6 text-slate-700">2 May 2027 to 1 August 2027</td>
                                
                            </tr>
                            <tr class="hover:bg-slate-50">
                                <td class="py-3.5 px-6 font-bold text-primary">Late</td>
                                <td class="py-3.5 px-6 text-slate-700">2 August 2027 to 26 October 2027</td>
                                
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            
            <!-- Registration Category Pricing Matrix -->
            <div class="mb-16" data-aos="fade-up">
                <h2 class="text-3xl font-bold text-primary mb-8 text-center">Registration Category & Pricing</h2>
                
                {% if batches is not empty %}
                    <div class="overflow-x-auto card-shadow rounded-xl max-w-5xl mx-auto" data-aos="fade-up" data-aos-delay="200">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-primary text-white text-sm uppercase tracking-wider">
                                    <th class="py-4 px-6 font-bold">Registration Category</th>
                                    <th class="py-4 px-6 font-bold">HLB Congress</th>
                                    <th class="py-4 px-6 font-bold">IOCV Conference</th>
                                    <th class="py-4 px-6 font-bold">Full Congress (HLB + IOCV)</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-slate-100 text-sm">
                                {% for batch in batches %}
                                    <tr class="hover:bg-slate-50 transition-colors">
                                        <td class="py-4 px-6 font-bold text-primary">
                                            {{ batch.name }}
                                            {% if batch.periodText %}
                                                <span class="block text-xs font-medium text-slate-500 italic mt-0.5">{{ batch.periodText }}</span>
                                            {% endif %}
                                        </td>
                                        <td class="py-4 px-6 font-semibold text-slate-700">{{ batch.hlbPrice ?? '-' }}</td>
                                        <td class="py-4 px-6 font-semibold text-slate-700">{{ batch.iocvPrice ?? '-' }}</td>
                                        <td class="py-4 px-6 font-bold text-secondary">{{ batch.fullPrice ?? '-' }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="max-w-5xl mx-auto p-3 text-sm">
                        <p>* Student: exclusively for master's and doctoral students. Student registration is subject to approval by the scientific committee, based on the submission and evaluation of the submitted abstract. The result will be announced within 30 days after the abstract submission (deadline: May 1, 2027). Ten selected student submissions will receive complimentary registration. <br>Postdoctoral researchers must register under the Professional category.

                        </p>
                    </div>

                    {# <div class="pt-4 flex justify-center">
                        <a href="https://doity.com.br/xxiv-iocv-viii-irchlb-2027" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 bg-secondary text-primary font-extrabold text-lg py-4 px-8 rounded-xl shadow-lg hover-effect">
                            Register 
                        </a>
                    </div> #}
                {% else %}
                    <p class="text-center text-slate-500">No registration categories defined yet.</p>
                {% endif %}
            </div>

            
            <!-- Optional Activities -->
            <div class="mb-16 max-w-5xl mx-auto" data-aos="fade-up">
                <h3 class="text-3xl font-bold text-primary mb-6 text-center">Optional Activities</h3>
                <div class="overflow-x-auto card-shadow rounded-xl">
                    <table class="w-full text-left border-collapse text-sm">
                        <thead>
                            <tr class="bg-primary text-white uppercase tracking-wider text-xs">
                                <th class="py-3.5 px-6 font-bold" colspan="2">Congress Dinner</th>
                                
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-slate-100">
                            <tr class="hover:bg-slate-50">
                                <td class="py-3.5 px-6 font-bold text-primary">Date</td>
                                <td class="py-3.5 px-6">27 October 2027 - 8:00 PM</td>
                            </tr>
                            <tr class="hover:bg-slate-50">
                                <td class="py-3.5 px-6 font-bold text-primary">Location</td>
                                <td class="py-3.5 px-6">shortly - it will be held at a different location from the event</td>
                            </tr>
                            <tr class="hover:bg-slate-50">
                                <td class="py-3.5 px-6 font-bold text-primary">Price</td>
                                <td class="py-3.5 px-6">shortly - purchase option available at the end of the event registration form on the ticketing platform</td>
                            </tr>
                            <tr class="hover:bg-slate-50">
                                <td class="py-3.5 px-6" colspan="2">Limited to 400 participants
</td>
                            </tr>
                        </tbody>
                    </table>
                    
                </div>
                <div class="py-6 text-center">
                    {# <a href="https://doity.com.br/technical-tour-xxiv-iocv-viii-irchlb-2027" target="_blank" class="inline-block bg-secondary text-primary font-bold text-lg px-10 py-4 rounded shadow-lg hover-effect">
                        Register for technical visit
                    </a> #}
                    {# <p class="py-6">Registration for the Congress dinner will open at a later date. Stay tuned for event updates.</p> #}
                </div>

                <div class="overflow-x-auto card-shadow rounded-xl">
                    <table class="w-full text-left border-collapse text-sm">
                        <thead>
                            <tr class="bg-primary text-white uppercase tracking-wider text-xs">
                                <th class="py-3.5 px-6 font-bold">Technical visit</th>
                                <th class="py-3.5 px-6 font-bold">US$</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-slate-100">
                           
                            <tr class="hover:bg-slate-50">
                                <td class="py-3.5 px-6  text-primary"><p><strong>28 October 2027</strong> - Fundecitrus (limited to 150 participants)*</p></td>
                                <td class="py-3.5 px-6 font-bold text-secondary">Shortly</td>
                            </tr>

                            <tr class="hover:bg-slate-50">
                                <td class="py-3.5 px-6  text-primary">
                                    <p><strong>29 October 2027</strong></p>
                                    <p><strong>Options (limited to 30 participants per itinerary)**</strong></p>
                                    <div class="p-3 space-y-1">
                                    <p><span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-xs font-bold mr-2">1</span><span>Experimental Station, Bebedouro + Citrus farm, Matão</span></p>
                                    <p><span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-xs font-bold mr-2">2</span><span>Citrus farm, Pirassununga + Sylvio Moreira Citrus Research Center (IAC), Cordeirópolis</span></p>
                                    <p><span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-xs font-bold mr-2">3</span><span>Citrus farm, Luís Antônio + Luiz de Queiroz College of Agriculture (ESALQ/USP), Piracicaba</span></p>
                                    <p><span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-xs font-bold mr-2">4</span><span>Citrus Farm 1, Pedregulho + Citrus Farm 2, Pedregulho</span></p>
                                    <p><span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-primary text-white text-xs font-bold mr-2">5</span><span>Citrus farm, Nova Europa + Experimental Station, Bebedouro</span></p>
                                    </div>
                                    <p>* Visit includes transportation</p>
                                    <p>** Visit includes transportation and lunch</p>
                                    </td>
                                <td class="py-3.5 px-6 font-bold text-secondary">Shortly</td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="pb-6 px-10 text-center border-t border-slate-100">
                        
                        
                        <a href="{{path('app_tours')}}" class="text-secondary hover:underline mt-4 inline-block">See more details about technical visits</a>
                    </div>
                </div>
                <div class="py-6 text-center">
                    {# <a href="https://doity.com.br/technical-tour-xxiv-iocv-viii-irchlb-2027" target="_blank" class="inline-block bg-secondary text-primary font-bold text-lg px-10 py-4 rounded shadow-lg hover-effect">
                        Register for technical visit
                    </a> #}
                    {# <p class="py-6">Registration for the Technical visits will open at a later date. Stay tuned for event updates.</p> #}
                </div>
            </div>
            
            
           

            <div class="mb-16 max-w-5xl mx-auto" data-aos="fade-up">
                <h3 class="text-2xl font-bold text-primary mb-6 text-center">What is included in your registration fees</h3>
                <div class="overflow-x-auto card-shadow rounded-xl">
                    <table class="w-full text-left border-collapse text-sm">
                        <thead>
                            <tr class="bg-slate-800 text-white uppercase tracking-wider text-xs text-center">
                                <th class="py-3.5 px-6 font-bold text-left">Category</th>
                                <th class="py-3.5 px-6 font-bold">All sessions</th>
                                <th class="py-3.5 px-6 font-bold">Conference material</th>
                                <th class="py-3.5 px-6 font-bold">Welcome cocktail</th>
                                <th class="py-3.5 px-6 font-bold">Coffee breaks</th>
                                <th class="py-3.5 px-6 font-bold">Congress dinner *</th>
                                <th class="py-3.5 px-6 font-bold">Technical visit *</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-slate-100">
                            <tr class="hover:bg-slate-50 text-center">
                                <td class="py-3.5 px-6 font-bold text-primary text-left">Professional</td>
                                <td class="py-3.5 px-6 text-slate-700"><i class="material-symbols-outlined text-secondary text-5xl mb-4">check</i></td>
                                <td class="py-3.5 px-6 text-slate-700"><i class="material-symbols-outlined text-secondary text-5xl mb-4">check</i></td>
                                <td class="py-3.5 px-6 text-slate-700"><i class="material-symbols-outlined text-secondary text-5xl mb-4">check</i></td>
                                <td class="py-3.5 px-6 text-slate-700"><i class="material-symbols-outlined text-secondary text-5xl mb-4">check</i></td>
                                <td class="py-3.5 px-6 text-slate-700"><i class="material-symbols-outlined text-gray-300 text-5xl mb-4">remove</i></td>
                                <td class="py-3.5 px-6 text-slate-700"><i class="material-symbols-outlined text-gray-300 text-5xl mb-4">remove</i></td>
                                
                            </tr>
                            <tr class="hover:bg-slate-50 text-center">
                                <td class="py-3.5 px-6 font-bold text-primary text-left">Student</td>
                                <td class="py-3.5 px-6 text-slate-700"><i class="material-symbols-outlined text-secondary text-5xl mb-4">check</i></td>
                                <td class="py-3.5 px-6 text-slate-700"><i class="material-symbols-outlined text-secondary text-5xl mb-4">check</i></td>
                                <td class="py-3.5 px-6 text-slate-700"><i class="material-symbols-outlined text-secondary text-5xl mb-4">check</i></td>
                                <td class="py-3.5 px-6 text-slate-700"><i class="material-symbols-outlined text-secondary text-5xl mb-4">check</i></td>
                                <td class="py-3.5 px-6 text-slate-700"><i class="material-symbols-outlined text-gray-300 text-5xl mb-4">remove</i></td>
                                <td class="py-3.5 px-6 text-slate-700"><i class="material-symbols-outlined text-gray-300 text-5xl mb-4">remove</i></td>
                            </tr>
                            <tr class="hover:bg-slate-50 text-center">
                                <td class="py-3.5 px-6 font-bold text-primary text-left">Accompanying Person</td>
                                <td class="py-3.5 px-6 text-slate-700"><i class="material-symbols-outlined text-gray-300 text-5xl mb-4">remove</i></td>
                                <td class="py-3.5 px-6 text-slate-700"><i class="material-symbols-outlined text-gray-300 text-5xl mb-4">remove</i></td>
                                <td class="py-3.5 px-6 text-slate-700"><i class="material-symbols-outlined text-secondary text-5xl mb-4">check</i></td>
                                <td class="py-3.5 px-6 text-slate-700"><i class="material-symbols-outlined text-secondary text-5xl mb-4">check</i></td>
                                <td class="py-3.5 px-6 text-slate-700"><i class="material-symbols-outlined text-gray-300 text-5xl mb-4">remove</i></td>
                                <td class="py-3.5 px-6 text-slate-700"><i class="material-symbols-outlined text-gray-300 text-5xl mb-4">remove</i></td>
                            </tr>
                        </tbody>
                    </table>
                    
                </div>
                <p class="py-2"><strong>Lunch is not includded in any registration category</strong><br>*Sales will be conducted separately from the event</p>
            </div>

            

            <!-- Pre-Registration / Form Callout -->
            {# <div class=" p-10 md:p-16 text-center mt-24 mb-24 max-w-4xl mx-auto" data-aos="fade-up">
                <h3 class="text-3xl uppercase font-bold text-primary mb-4">Ready to Register?</h3>
                
                <a href="https://doity.com.br/xxiv-iocv-viii-irchlb-2027" target="_blank" class="inline-block bg-secondary text-primary font-bold text-lg px-10 py-4 rounded shadow-lg hover-effect">
                    Register
                </a>
                
            </div> #}

            

            <div class="mb-16 max-w-5xl mx-auto" data-aos="fade-up">
                <div class="flex items-center gap-4 bg-primary-50 border border-primary-200 border-l-4 border-l-secondary rounded-xl p-5 card-shadow">
                    <div class="w-12 h-12 rounded-full bg-primary text-secondary flex items-center justify-center flex-shrink-0">
                        <span class="material-symbols-outlined text-2xl">translate</span>
                    </div>
                    <p class="text-primary font-semibold text-base md:text-lg">
                        The event will be conducted in English, with simultaneous interpretation into Portuguese.
                    </p>
                </div>
            </div>

            <!-- FAQ Section -->
            {% if faq_items is not empty %}
                <div>
                    <h3 class="text-3xl font-bold text-primary mb-8 text-center">Registration FAQ & Policies</h3>
                    <div class="max-w-3xl mx-auto space-y-4" data-aos="fade-up">
                        {% for faq in faq_items %}
                            <details class="group bg-slate-50 rounded-lg border border-slate-200 open:bg-white open:ring-1 open:ring-slate-300 open:shadow-sm">
                                <summary class="flex justify-between items-center font-medium cursor-pointer list-none p-5 text-slate-800">
                                    <span class="font-bold">{{ faq.question }}</span>
                                    <span class="transition group-open:rotate-180 material-symbols-outlined text-slate-400">expand_more</span>
                                </summary>
                                <div class="text-slate-600 p-5 pt-0 border-t border-slate-100 mt-2">
                                    <p>{{ faq.answer }}</p>
                                </div>
                            </details>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

        </div>
    </section>
{% endblock %}

{% block stylesheets %}
    {# Preload the LCP Banner Image #}
    {% if event_config and event_config.heroImage and event_config.heroImage.imageName %}
        <link rel="preload" as="image" href="{{ ('uploads/' ~ event_config.heroImage.imageName)|imagine_filter('banner_hero') }}" />
    {% else %}
        <link rel="preload" as="image" href="{{ asset('images/hero-bg.jpg') }}" />
    {% endif %}
{% endblock %}
