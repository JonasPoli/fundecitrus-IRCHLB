{% extends 'pub/base.html.twig' %}

{% block body %}
    <section class="bg-slate-900 text-white py-20 relative overflow-hidden border-b-8 border-secondary">
        {% if event_config and event_config.heroImage and event_config.heroImage.imageName %}
            <div class="absolute inset-0 opacity-30 bg-cover bg-center" style="background-image: url('{{ ('uploads/' ~ event_config.heroImage.imageName)|imagine_filter('banner_hero') }}'); background-color: #004040;"></div>
        {% else %}
            <div class="absolute inset-0 opacity-30 bg-cover bg-center" style="background-image: url('{{ asset('images/hero-bg.jpg') }}'); background-color: #004040;"></div>
        {% endif %}
        <div class="container mx-auto px-6 text-center relative z-10">
            <span class="material-symbols-outlined text-secondary text-5xl mb-4">confirmation_number</span>
            <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Registration</h1>
            <p class="text-secondary text-lg max-w-2xl mx-auto">Secure your spot at the world's most significant citrus desease events. Review our distinct categories and deadlines below.</p>
        </div>
    </section>

    <!-- Pricing Tables -->
    <section class="py-24 bg-white text-slate-800">
        <div class="container mx-auto px-6">
            
            <!-- Registration Category Pricing Matrix -->
            <div class="mb-16" data-aos="fade-up">
                <h2 class="text-3xl font-bold text-primary mb-8 text-center">Registration Category & Pricing</h2>
                
                {% if batches is not empty %}
                    <div class="overflow-x-auto card-shadow rounded-xl max-w-5xl mx-auto" data-aos="fade-up" data-aos-delay="200">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-primary text-white text-sm uppercase tracking-wider">
                                    <th class="py-4 px-6 font-bold">Registration Category</th>
                                    <th class="py-4 px-6 font-bold">HLB Congress</th>
                                    <th class="py-4 px-6 font-bold">IOCV Conference</th>
                                    <th class="py-4 px-6 font-bold">Full Congress (HLB + IOCV)</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-slate-100 text-sm">
                                {% for batch in batches %}
                                    <tr class="hover:bg-slate-50 transition-colors">
                                        <td class="py-4 px-6 font-bold text-primary">
                                            {{ batch.name }}
                                            {% if batch.periodText %}
                                                <span class="block text-xs font-medium text-slate-500 italic mt-0.5">{{ batch.periodText }}</span>
                                            {% endif %}
                                        </td>
                                        <td class="py-4 px-6 font-semibold text-slate-700">{{ batch.hlbPrice ?? '-' }}</td>
                                        <td class="py-4 px-6 font-semibold text-slate-700">{{ batch.iocvPrice ?? '-' }}</td>
                                        <td class="py-4 px-6 font-bold text-secondary">{{ batch.fullPrice ?? '-' }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="text-center text-slate-500">No registration categories defined yet.</p>
                {% endif %}
            </div>

            <!-- Registration Periods & Deadlines -->
            <div class="mb-16 max-w-5xl mx-auto" data-aos="fade-up">
                <h3 class="text-2xl font-bold text-primary mb-6 text-center">Registration Periods & Deadlines</h3>
                <div class="overflow-x-auto card-shadow rounded-xl">
                    <table class="w-full text-left border-collapse text-sm">
                        <thead>
                            <tr class="bg-slate-800 text-white uppercase tracking-wider text-xs">
                                <th class="py-3.5 px-6 font-bold">Period</th>
                                <th class="py-3.5 px-6 font-bold">Dates</th>
                                <th class="py-3.5 px-6 font-bold">Deadline / Notice</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-slate-100">
                            <tr class="hover:bg-slate-50">
                                <td class="py-3.5 px-6 font-bold text-primary">Early Bird</td>
                                <td class="py-3.5 px-6 text-slate-700">01/10/2026 to 01/06/2027</td>
                                <td class="py-3.5 px-6 text-slate-500 font-medium">Up to 4 months before event</td>
                            </tr>
                            <tr class="hover:bg-slate-50">
                                <td class="py-3.5 px-6 font-bold text-primary">Regular</td>
                                <td class="py-3.5 px-6 text-slate-700">02/06/2027 to 01/08/2027</td>
                                <td class="py-3.5 px-6 text-slate-500 font-medium">Up to 2 months before event</td>
                            </tr>
                            <tr class="hover:bg-slate-50">
                                <td class="py-3.5 px-6 font-bold text-primary">Late</td>
                                <td class="py-3.5 px-6 text-slate-700">02/08/2027 to 24/10/2027</td>
                                <td class="py-3.5 px-6 text-slate-500 font-medium">Up to event day (subject to availability)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Category Notes & Special Conditions -->
            <div class="mb-16 max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6" data-aos="fade-up">
                <div class="bg-amber-50/70 border border-amber-200 rounded-xl p-6 card-shadow">
                    <h4 class="font-bold text-amber-900 text-base mb-2 flex items-center gap-2">
                        <span class="material-symbols-outlined text-amber-600">school</span>
                        Student Registration Policy
                    </h4>
                    <ul class="text-xs text-amber-800 space-y-1.5 list-disc pl-4 font-medium">
                        <li>Limited to 100 spots.</li>
                        <li>Must be actively working with HLB / greening research.</li>
                        <li>Student registration is available only during Early Bird with abstract submission.</li>
                    </ul>
                </div>
                <div class="bg-slate-100 border border-slate-200 rounded-xl p-6 card-shadow">
                    <h4 class="font-bold text-slate-800 text-base mb-2 flex items-center gap-2">
                        <span class="material-symbols-outlined text-slate-600">family_restroom</span>
                        Accompanying Person Policy
                    </h4>
                    <p class="text-xs text-slate-600 leading-relaxed font-medium">
                        No access to auditorium sessions. Restricted to family members or personal caregivers.
                    </p>
                </div>
            </div>

            <!-- Pre-Registration / Form Callout -->
            <div class="bg-slate-50 rounded-2xl p-10 md:p-16 text-center card-shadow border border-slate-100 mb-24 max-w-4xl mx-auto hover-effect" data-aos="fade-up">
                <h3 class="text-2xl font-bold text-primary mb-4">Ready to Register?</h3>
                <p class="text-slate-600 mb-8 max-w-2xl mx-auto">The process uses a robust gateway accepting Credit Cards, Boletos, PIX. International attendees possess a streamlined portal restricted to Credit Card + Passport validation.</p>
                <a href="#" onclick="alert('Registration forms are handled externally. Link will be available soon.'); return false;" 
                   class="inline-block bg-secondary text-primary font-bold text-lg px-10 py-4 rounded shadow-lg hover-effect">
                    Proceed to Form
                </a>
            </div>

            <!-- Documents and Receipts Logistics -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-24 max-w-4xl mx-auto">
                <div class="bg-white p-8 rounded-2xl border border-slate-100 card-shadow hover-effect" data-aos="fade-right">
                    <h3 class="text-2xl font-bold text-primary mb-4 flex items-center gap-3">
                        <span class="material-symbols-outlined text-secondary">request_quote</span>
                        Receipts & Invoices
                    </h3>
                    <p class="text-slate-600 mb-4">Official invoices (Notas Fiscais) will be issued following strict regulations of the Ribeirão Preto Municipal Government.</p>
                    <p class="text-slate-600">Please assure all billing information is immaculate during checkout, as subsequent alterations to corporate names may not be permitted.</p>
                </div>
                <div class="bg-white p-8 rounded-2xl border border-slate-100 card-shadow hover-effect" data-aos="fade-left">
                    <h3 class="text-2xl font-bold text-primary mb-4 flex items-center gap-3">
                        <span class="material-symbols-outlined text-secondary">workspace_premium</span>
                        Certificates
                    </h3>
                    <p class="text-slate-600">Certificates of attendance and presentation will be available in the restricted user area up to two days after the conclusion of the event.</p>
                </div>
            </div>

            <!-- FAQ Section -->
            {% if faq_items is not empty %}
                <div>
                    <h3 class="text-3xl font-bold text-primary mb-8 text-center">Registration FAQ & Policies</h3>
                    <div class="max-w-3xl mx-auto space-y-4" data-aos="fade-up">
                        {% for faq in faq_items %}
                            <details class="group bg-slate-50 rounded-lg border border-slate-200 open:bg-white open:ring-1 open:ring-slate-300 open:shadow-sm">
                                <summary class="flex justify-between items-center font-medium cursor-pointer list-none p-5 text-slate-800">
                                    <span class="font-bold">{{ faq.question }}</span>
                                    <span class="transition group-open:rotate-180 material-symbols-outlined text-slate-400">expand_more</span>
                                </summary>
                                <div class="text-slate-600 p-5 pt-0 border-t border-slate-100 mt-2">
                                    <p>{{ faq.answer }}</p>
                                </div>
                            </details>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

        </div>
    </section>
{% endblock %}

{% block stylesheets %}
    {# Preload the LCP Banner Image #}
    {% if event_config and event_config.heroImage and event_config.heroImage.imageName %}
        <link rel="preload" as="image" href="{{ ('uploads/' ~ event_config.heroImage.imageName)|imagine_filter('banner_hero') }}" />
    {% else %}
        <link rel="preload" as="image" href="{{ asset('images/hero-bg.jpg') }}" />
    {% endif %}
{% endblock %}
