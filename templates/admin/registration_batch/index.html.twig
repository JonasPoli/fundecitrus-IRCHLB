{% extends 'admin/base.html.twig' %}

{% block body %}

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="fa-solid fa-rectangle-list" style="margin-right:8px;color:var(--bm-accent)" aria-hidden="true"></i>
            Lotes de Inscrição        </h1>
        <p class="page-subtitle"></p>
    </div>
    <div>
        <a href="{{ path('app_admin_registration_batch_new') }}" class="btn-primary">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
            Adicionar
        </a>
    </div>
</div>

<div class="admin-card">
    
    <table class="admin-table">
        <thead>
            <tr>
                <th style="width: 30px;"></th>
                <th>Category</th>
                <th>Period</th>
                <th>HLB Congress</th>
                <th>IOCV Conference</th>
                <th>Full Congress</th>
                <th>Notes / Restrictions</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="registration-batch-sortable">
            {% for registration_batch in registration_batches %}
                <tr class="sortable-row" data-id="{{ registration_batch.id }}">
                    <td style="width: 30px; text-align: center;"><i class="fa-solid fa-grip-vertical" style="cursor: grab; color: #a1a1aa;"></i></td>
                    <td class="font-bold text-primary">{{ registration_batch.name }}</td>
                    <td>{{ registration_batch.periodText ?? '-' }}</td>
                    <td>{{ registration_batch.hlbPrice ?? '-' }}</td>
                    <td>{{ registration_batch.iocvPrice ?? '-' }}</td>
                    <td>{{ registration_batch.fullPrice ?? '-' }}</td>
                    <td class="text-xs text-slate-500 max-w-xs truncate">{{ registration_batch.notes ?? '-' }}</td>
                    <td>
                        <a href="{{ path('app_admin_registration_batch_edit', {'id': registration_batch.id}) }}" class="btn-secondary" aria-label="Edit {{ registration_batch.name }}" title="Edit {{ registration_batch.name }}">
                            <i class="fa-solid fa-pen" aria-hidden="true"></i> Edit
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8">No categories found.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.dataTables.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.0.2/css/buttons.dataTables.min.css">
{% endblock %}

{% block javascripts %}
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>

    <script>
        {% if registration_batches is not empty %}
            $(document).ready(function () {
            $('.admin-table').DataTable({
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/2.0.8/i18n/pt-BR.json',
                },
                ordering: false,
                pageLength: 10,
                lengthMenu: [[5, 10, 25, -1], [5, 10, 25, 'Todos']],
            });
        {% endif %}
    });
    </script>
    {{ include('admin/_sortable_script.html.twig', {
        tbody_id: 'registration-batch-sortable',
        reorder_url: path('app_admin_reorder', { entityName: 'RegistrationBatch' })
    }) }}
{% endblock %}