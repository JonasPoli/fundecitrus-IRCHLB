{{ form_start(form) }}
    <div class="admin-card space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {{ form_row(form.title) }}
            {{ form_row(form.slug) }}
        </div>
        
        <div class="wab-field mb-4">
            {{ form_label(form.content) }}
            
            <link rel="stylesheet" href="https://cdn.quilljs.com/1.3.7/quill.snow.css">
            <style>
                .ql-container {
                    font-family: inherit;
                    font-size: 14px;
                }
                .ql-editor {
                    min-height: 250px;
                    background: #fff;
                    color: #333;
                }
            </style>
            
            <div id="quill-editor" class="border border-slate-300 rounded-b"></div>
            
            {# Campo oculto real que sincroniza com o Quill #}
            <div class="hidden">
                {{ form_widget(form.content, {'required': false}) }}
            </div>
            
            {{ form_errors(form.content) }}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {{ form_row(form.updatedAt) }}
        </div>
    </div>
    
    <div class="w-full text-right mt-6">
        <button type="submit" class="btn-primary" id="submit-btn">
            <i class="fa-solid fa-check" aria-hidden="true"></i>
            Salvar
        </button>
    </div>
{{ form_end(form) }}

<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
<script>
    function initQuillEditor() {
        const editor = document.getElementById('quill-editor');
        if (!editor || editor.__quillInstance) {
            return;
        }

        const textarea = document.querySelector('textarea[name*="[content]"]') || document.querySelector('[name*="[content]"]');
        if (!textarea) {
            return;
        }

        if (typeof Quill === 'undefined') {
            const script = document.querySelector('script[src*="quill"]');
            if (script) {
                script.addEventListener('load', initQuillEditor, { once: true });
            }
            return;
        }

        editor.__quillInstance = new Quill(editor, {
            theme: 'snow',
            modules: {
                toolbar: [
                    [{ 'header': [1, 2, 3, false] }],
                    ['bold', 'italic', 'underline', 'strike'],
                    [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                    ['link', 'clean']
                ]
            }
        });

        const quill = editor.__quillInstance;

        if (textarea.value) {
            quill.root.innerHTML = textarea.value;
        }

        const syncContent = () => {
            const text = quill.getText().trim();
            const html = quill.root.innerHTML;
            if (text.length === 0 && (html === '<p><br></p>' || html === '')) {
                textarea.value = '';
            } else {
                textarea.value = html;
            }
        };

        quill.on('text-change', syncContent);

        const form = textarea.closest('form');
        if (form) {
            const submitBtn = form.querySelector('button[type="submit"]');
            if (submitBtn) {
                submitBtn.addEventListener('click', syncContent);
            }
            form.addEventListener('submit', syncContent);
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initQuillEditor);
    } else {
        initQuillEditor();
    }
    document.addEventListener('turbo:load', initQuillEditor);
</script>