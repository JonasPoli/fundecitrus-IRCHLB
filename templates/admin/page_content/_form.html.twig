{{ form_start(form) }}
    <div class="admin-card space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {{ form_row(form.title) }}
            {{ form_row(form.slug) }}
        </div>
        
        <div class="wab-field mb-4">
            {{ form_label(form.content) }}
            
            <link href="https://cdn.jsdelivr.net/npm/suneditor@2/dist/css/suneditor.min.css" rel="stylesheet">
            
            {{ form_widget(form.content, {'required': false, 'attr': {'data-suneditor': 'true'}}) }}
            
            {{ form_errors(form.content) }}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {{ form_row(form.updatedAt) }}
        </div>
    </div>
    
    <div class="w-full text-right mt-6">
        <button type="submit" class="btn-primary" id="submit-btn">
            <i class="fa-solid fa-check" aria-hidden="true"></i>
            Salvar
        </button>
    </div>
{{ form_end(form) }}

<script src="https://cdn.jsdelivr.net/npm/suneditor@2/dist/suneditor.min.js"></script>
<script>
    function initSunEditor() {
        const textarea = document.querySelector('textarea[data-suneditor]');
        if (!textarea || textarea.__suneditorInstance) {
            return;
        }

        if (typeof SUNEDITOR === 'undefined') {
            const script = document.querySelector('script[src*="suneditor"]');
            if (script) {
                script.addEventListener('load', initSunEditor, { once: true });
            }
            return;
        }

        const editor = SUNEDITOR.create(textarea, {
            width: '100%',
            height: '350px',
            buttonList: [
                ['undo', 'redo'],
                ['font', 'fontSize'],
                ['bold', 'underline', 'italic', 'strike'],
                ['fontColor'],
                ['removeFormat'],
                ['outdent', 'indent'],
                ['align', 'list'],
                ['table', 'link', 'image'],
                ['showBlocks', 'codeView'],
            ],
            attributesWhitelist: {
                all: 'class|style|id'
            },
            allowedClassNames: '.+'
        });

        textarea.__suneditorInstance = editor;

        editor.onChange = function () {
            editor.save();
        };

        const form = textarea.closest('form');
        if (form) {
            form.addEventListener('submit', function () {
                if (editor.core._variable.isCodeView) {
                    editor.core.toggleCodeView();
                }
                editor.save();
            });
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSunEditor);
    } else {
        initSunEditor();
    }
    document.addEventListener('turbo:load', initSunEditor);

    document.addEventListener('turbo:before-cache', function () {
        const textarea = document.querySelector('textarea[data-suneditor]');
        if (textarea && textarea.__suneditorInstance) {
            textarea.__suneditorInstance.destroy();
            delete textarea.__suneditorInstance;
        }
    });
</script>